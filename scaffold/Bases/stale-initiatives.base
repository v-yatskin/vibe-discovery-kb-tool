filters:
  and:
    - type == "initiative"
    - status == "in_progress"
    - file.mtime < now() - "30 days"
views:
  - type: table
    name: Stale initiatives (in-progress, untouched 30+ days)
    groupBy:
      property: file.mtime
      direction: ASC
    order:
      - file.name
      - title
      - priority
      - file.mtime
